{
  "name": "mathsmart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --test \"src/modules/**/__tests__/*.test.js\" \"src/config/__tests__/*.test.js\"",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:reset:migrations": "supabase db reset --no-seed",
    "db:lint": "supabase db lint --fail-on error",
    "db:advisors": "supabase db advisors --local --type all --fail-on error",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@supabase/server": "^1.5.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-colors": "^3.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "concurrently": "9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4"
  }
}
