# ===================================================
# MathSmart Environment Configuration Template
# Duplicate this file to .env.local for local dev
# ===================================================

# Supabase Credentials (from project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend FastAPI Service URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Cloudinary (Media assets)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ===================================================
# Server-side only. FastAPI reads these; the browser never does.
# Never add the NEXT_PUBLIC_ prefix to anything below, and never
# commit a real value. Names only live here.
# ===================================================

# Supabase, as the FastAPI backend sees it. The secret key is the
# service_role identity used to reach the private `app` schema.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Groq. Advisory only: grading, mastery, progression and intervention
# triggers are deterministic and must work with GROQ_ENABLED=false.
# The credential and the selected model are deployment values and are
# never stored in system_settings nor returned to any client.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=your-groq-model-id-here
GROQ_ENABLED=false
GROQ_TIMEOUT_SECONDS=8
